# Django secret key used for cryptographic signing (sessions, CSRF, etc.)
SECRET_KEY=django-insecure-change-this-to-a-secure-random-string-for-production

# Debug mode (True for development, False for production)
DEBUG=True

# 32-byte URL-safe base64-encoded Fernet key used for application-level note content encryption.
# Generate one using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
